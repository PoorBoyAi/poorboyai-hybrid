# Firebase web app config for the Ask PB hybrid demo.
# Copy this file to `.env` and fill in the values from:
#   Firebase console > Project settings > General > Your apps > Web app
# The Firebase web config is not a secret, but it stays out of git so each
# environment carries its own project. NEVER put any Gemini API key here —
# AI Logic calls go through Firebase with App Check, no key ships in the app.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — reCAPTCHA Enterprise (Fraud Defense) site key.
# Firebase deprecated the Classic reCAPTCHA v3 App Check provider; App Check
# now registers with the reCAPTCHA Enterprise provider. Create an Enterprise
# site key in the Google Cloud console (reCAPTCHA Enterprise; domains: your
# Firebase Hosting domain + localhost), then register it in Firebase console
# > App Check > Apps > your web app > Fraud Defense / reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
